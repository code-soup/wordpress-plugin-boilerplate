# WordPress Development Environment Configuration
# Copy this file to .env.local and update with your local values

# WordPress development URL (proxy target when using npm run dev)
WP_DEV_URL=http://localhost

# URL path segment to wp-content/plugins (not a filesystem path)
WP_CONTENT_PATH=/wp-content/plugins

# Webpack dev server host URL (port overridden by DEV_PROXY_PORT)
DEV_PROXY_URL=http://localhost
DEV_PROXY_PORT=8080

# Optional: force asset publicPath (production CI/CD, CDN)
# WP_PUBLIC_PATH=https://cdn.example.com/wp-content/plugins/my-plugin/dist/